{
  "name": "qicheng-backend",
  "version": "1.0.0",
  "description": "启程OPC后端服务 - 实践拆解与孵化系统",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:comprehensive": "ts-node src/scripts/comprehensiveTest.ts",
    "cleanup:old-users": "ts-node src/scripts/cleanupOldUsers.ts",
    "create:opc-results": "ts-node src/scripts/createOPCResults.ts",
    "seed": "ts-node src/utils/seed.ts",
    "seed:personalized": "ts-node src/utils/seedPersonalized.ts",
    "seed:features": "ts-node src/utils/seedPersonalizedFeatures.ts",
    "seed:all": "npm run seed && npm run seed:personalized && npm run seed:features",
    "cleanup:test-data": "ts-node src/utils/cleanupTestData.ts",
    "qdrant:init": "ts-node src/scripts/initQdrant.ts",
    "tags:import": "ts-node src/scripts/importTags.ts",
    "tags:import-complete": "ts-node src/scripts/importCompleteTags.ts",
    "vectors:generate-static": "ts-node src/scripts/generateStaticVectors.ts",
    "vector:import-mock": "ts-node src/scripts/importMockData.ts",
    "vector:test-complete": "ts-node src/scripts/testVectorComplete.ts",
    "vector:test-real": "ts-node src/scripts/testRealUsability.ts",
    "recommend:test-production": "ts-node src/scripts/testProductionRecommendation.ts",
    "recommend:test-scientific": "ts-node src/scripts/testScientificRecommendation.ts",
    "recommend:reverse-validation": "ts-node src/scripts/reverseValidation.ts",
    "recommend:test-project": "ts-node src/scripts/testProjectRecommendation.ts",
    "test:end-to-end": "ts-node src/scripts/testEndToEnd.ts"
  },
  "keywords": [
    "practice",
    "incubation",
    "opc",
    "ai-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "openai": "^4.20.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
