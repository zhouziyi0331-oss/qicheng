@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}page{background:#0a0c10;color:#fff;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Hiragino Sans GB,Microsoft YaHei,Helvetica Neue,Helvetica,Arial,sans-serif}.container{background:#0a0c10;min-height:100vh}