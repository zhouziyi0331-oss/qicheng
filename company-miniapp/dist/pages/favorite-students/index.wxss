rpx}.favorite-students-page .student-list .student-card .student-actions .action-btn{border:none;border-radius:12rpx;flex:1;font-size:34rpx;font-weight:400;padding:12rpx}.favorite-students-page .student-list .student-card .student-actions .action-btn.primary{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-weight:600;padding:12rpx 24rpx;transition:all .3s ease}.favorite-students-page .student-list .student-card .student-actions .action-btn.primary:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.favorite-students-page .student-list .student-card .student-actions .action-btn.primary:active{transform:translateY(0)}.favorite-students-page .student-list .student-card .student-actions .action-btn.primary:disabled{cursor:not-allowed;opacity:.5}.favorite-students-page .student-list .student-card .student-actions .action-btn.secondary{background:transparent;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-weight:500;padding:12rpx 24rpx;transition:all .3s ease}.favorite-students-page .student-list .student-card .student-actions .action-btn.secondary:hover{background:rgba(30,41,59,.8);border-color:rgba(75,85,99,.4)}.favorite-students-page .student-list .student-card .student-actions .action-btn.secondary:active{transform:scale(.98)}.favorite-students-page .student-list .student-card .student-actions .action-btn.secondary:disabled{cursor:not-allowed;opacity:.5}.favorite-students-page .student-list .empty-state{padding:120rpx 0;text-align:center}.favorite-students-page .student-list .empty-state .empty-icon{background:linear-gradient(135deg,#fa709a,#fee140);border-radius:60rpx;height:120rpx;margin:0 auto 20rpx;width:120rpx}.favorite-students-page .student-list .empty-state .empty-text{color:#4b5563;font-size:38rpx;margin-bottom:20rpx}.favorite-students-page .student-list .empty-state .browse-btn{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;display:inline-block;font-size:14rpx;font-size:34rpx;font-weight:600;padding:12px 24px;transition:all .3s ease}.favorite-students-page .student-list .empty-state .browse-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.favorite-students-page .student-list .empty-state .browse-btn:active{transform:translateY(0)}.favorite-students-page .student-list .empty-state .browse-btn:disabled{cursor:not-allowed;opacity:.5}