ttom:20rpx}.rate-task-page .rating-section .section-header .section-title{color:#fff;font-size:40rpx;font-weight:600}.rate-task-page .rating-section .section-header .required{color:#ef4444;margin-left:6rpx}.rate-task-page .rating-section .section-header .optional{color:#4b5563;font-size:32rpx;margin-left:12rpx}.rate-task-page .rating-section .rating-item{align-items:center;border-bottom:1rpx solid rgba(75,85,99,.15);display:flex;justify-content:space-between;padding:16rpx 0}.rate-task-page .rating-section .rating-item:last-child{border-bottom:none}.rate-task-page .rating-section .rating-item .item-label{color:#fff;font-size:38rpx}.rate-task-page .rating-section .rating-item .stars{display:flex;gap:12rpx}.rate-task-page .rating-section .rating-item .stars .star{color:rgba(75,85,99,.15);font-size:48rpx}.rate-task-page .rating-section .rating-item .stars .star.active{color:#f59e0b}.rate-task-page .rating-section .tags-group{margin-bottom:20rpx}.rate-task-page .rating-section .tags-group:last-child{margin-bottom:0}.rate-task-page .rating-section .tags-group .tags-label{color:#9ca3af;font-size:34rpx;margin-bottom:12rpx}.rate-task-page .rating-section .tags-group .tags{display:flex;flex-wrap:wrap;gap:12rpx}.rate-task-page .rating-section .tags-group .tags .tag{background:rgba(20,28,40,.4);border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#9ca3af;font-size:32rpx;padding:8rpx 20rpx}.rate-task-page .rating-section .tags-group .tags .tag.selected{background:rgba(99,102,241,.08);border-color:#6366f1;color:#6366f1}.rate-task-page .rating-section .comment-input{background:#1e293b;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;font-size:14rpx;line-height:1.6;min-height:150rpx;padding:16rpx;width:100%}.rate-task-page .rating-section .comment-input:focus{border-color:#6366f1;outline:none}.rate-task-page .rating-section .comment-input::-moz-placeholder{color:#6b7280}.rate-task-page .rating-section .comment-input::placeholder{color:#6b7280}.rate-task-page .rating-section .char-count{color:#4b5563;font-size:32rpx;margin-top:6rpx;text-align:right}.rate-task-page .rating-section .anonymous-option{align-items:center;background:rgba(20,28,40,.4);border-radius:12rpx;display:flex;padding:16rpx}.rate-task-page .rating-section .anonymous-option .checkbox{align-items:center;border:2rpx solid rgba(75,85,99,.2);border-radius:4rpx;display:flex;height:20rpx;justify-content:center;margin-right:12rpx;width:20rpx}.rate-task-page .rating-section .anonymous-option .checkbox.checked{background:#6366f1;border-color:#6366f1}.rate-task-page .rating-section .anonymous-option .checkbox.checked .check-icon{color:#fff;font-size:34rpx}.rate-task-page .rating-section .anonymous-option .option-text{color:#fff;font-size:34rpx;margin-right:8rpx}.rate-task-page .rating-section .anonymous-option .option-hint{color:#4b5563;font-size:32rpx}.rate-task-page .submit-section .submit-btn{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-size:38rpx;font-weight:600;font-weight:500;padding:16rpx;transition:all .3s ease;width:100%}.rate-task-page .submit-section .submit-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.rate-task-page .submit-section .submit-btn:active{transform:translateY(0)}.rate-task-page .submit-section .submit-btn:disabled{cursor:not-allowed;opacity:.5}.rate-task-page .submit-section .submit-btn.disabled{opacity:.5}