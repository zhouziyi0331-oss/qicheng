@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.task-progress{background:#0a0c10;min-height:100vh;padding:20rpx}.task-progress.empty,.task-progress.loading{align-items:center;color:#9ca3af;display:flex;font-size:36rpx;justify-content:center}.task-header{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);margin-bottom:20rpx;padding:24rpx}.task-header .task-title{color:#fff;display:block;font-size:44rpx;font-weight:700;margin-bottom:20rpx}.task-header .current-status{align-items:center;background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(99,102,241,.2));border:2rpx solid rgba(139,92,246,.3);border-radius:16rpx;display:flex;gap:16rpx;padding:16rpx 20rpx}.task-header .current-status .status-label{color:#9ca3af;font-size:34rpx}.task-header .current-status .status-value{color:#06b6d4;font-size:36rpx;font-weight:700}.timeline{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);padding:24rpx}.timeline-item{padding-bottom:24rpx;padding-left:80rpx;position:relative}.timeline-item:last-child{padding-bottom:0}.timeline-item .timeline-dot{align-items:center;border-radius:9999rpx;display:flex;height:48rpx;justify-content:center;left:0;position:absolute;top:0;width:48rpx;z-index:2}.timeline-item .timeline-dot .dot-icon{font-size:40rpx;font-weight:700}.timeline-item .timeline-line{background:hsla(0,0%,100%,.1);bottom:-24rpx;left:24rpx;position:absolute;top:48rpx;width:4rpx;z-index:1}.timeline-item .timeline-line.completed{background:linear-gradient(135deg,#8b5cf6,#6366f1)}.timeline-item.completed .timeline-dot{background:linear-gradient(135deg,#8b5cf6,#6366f1);box-shadow:0 0 20rpx rgba(139,92,246,.5)}.timeline-item.completed .timeline-dot .dot-icon{color:#fff}.timeline-item.completed .step-title{color:#fff}.timeline-item.current .timeline-dot{background:linear-gradient(135deg,rgba(0,245,255,.3),rgba(0,245,255,.1));border:4rpx solid #06b6d4;box-shadow:0 0 30rpx rgba(0,245,255,.6)}.timeline-item.current .timeline-dot .dot-icon{animation:pulse 2s ease-in-out infinite;color:#06b6d4}.timeline-item.current .step-title{color:#06b6d4;font-weight:700}.timeline-item.current .timeline-content{background:linear-gradient(135deg,rgba(0,245,255,.05),rgba(0,245,255,.02));border:2rpx solid rgba(0,245,255,.2);border-radius:12rpx;padding:16rpx}.timeline-item.pending .timeline-dot{background:hsla(0,0%,100%,.05);border:2rpx solid hsla(0,0%,100%,.2)}.timeline-item.pending .timeline-dot .dot-icon{color:#9ca3af}.timeline-item.pending .step-title{color:#9ca3af}.timeline-item.pending .step-description{color:hsla(0,0%,100%,.3)}.timeline-content .step-title{display:block;font-size:40rpx;font-weight:500;margin-bottom:8rpx}.timeline-content .step-description{color:#9ca3af;display:block;font-size:36rpx;line-height:1.6;margin-bottom:12rpx}.timeline-content .step-meta{align-items:center;display:flex;font-size:34rpx;gap:8rpx}.timeline-content .step-meta .meta-time{color:#9ca3af}.timeline-content .step-meta .meta-divider{color:hsla(0,0%,100%,.2)}.timeline-content .step-meta .meta-operator{color:#06b6d4}@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(1.1)}}