yment-page .payment-info-card .card-title{border-bottom:1rpx solid rgba(75,85,99,.15);color:#fff;font-size:40rpx;font-weight:600;margin-bottom:20rpx;padding-bottom:16rpx}.payment-page .payment-info-card .amount-section{background:rgba(20,28,40,.4);border-radius:12rpx;margin-bottom:20rpx;padding:24rpx 0;text-align:center}.payment-page .payment-info-card .amount-section .amount-label{color:#9ca3af;font-size:34rpx;margin-bottom:12rpx}.payment-page .payment-info-card .amount-section .amount-value{color:#f59e0b;font-size:72rpx;font-weight:600;line-height:1}.payment-page .payment-info-card .detail-list .detail-row{align-items:center;border-bottom:1rpx solid rgba(75,85,99,.15);display:flex;justify-content:space-between;padding:16rpx 0}.payment-page .payment-info-card .detail-list .detail-row:last-child{border-bottom:none}.payment-page .payment-info-card .detail-list .detail-row .detail-label{color:#9ca3af;font-size:34rpx}.payment-page .payment-info-card .detail-list .detail-row .detail-value{color:#fff;font-size:34rpx;font-weight:400}.payment-page .payment-info-card .detail-list .detail-row .detail-value.highlight{color:#6366f1;font-weight:600}.payment-page .payment-method-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1px solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.payment-page .payment-method-card .card-title{color:#fff;font-size:40rpx;font-weight:600;margin-bottom:20rpx}.payment-page .payment-method-card .method-item{align-items:center;background:rgba(20,28,40,.4);border:2rpx solid transparent;border-radius:12rpx;display:flex;margin-bottom:12rpx;padding:16rpx}.payment-page .payment-method-card .method-item:last-child{margin-bottom:0}.payment-page .payment-method-card .method-item.selected{background:rgba(99,102,241,.05);border-color:#6366f1}.payment-page .payment-method-card .method-item .method-icon{align-items:center;background:#10b981;border-radius:8rpx;display:fl