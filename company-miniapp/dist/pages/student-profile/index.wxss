@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.student-profile{background:#0a0c10;min-height:100vh;padding:20rpx}.student-profile.empty,.student-profile.loading{align-items:center;color:#9ca3af;display:flex;font-size:36rpx;justify-content:center}.profile-header{align-items:center;backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);display:flex;gap:20rpx;margin-bottom:20rpx;padding:24rpx}.profile-header .avatar{border:4rpx solid linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:9999rpx;height:120rpx;width:120rpx}.profile-header .info{flex:1}.profile-header .info .name{color:#fff;display:block;font-size:44rpx;font-weight:700;margin-bottom:12rpx}.profile-header .info .stats{align-items:center;color:#9ca3af;display:flex;font-size:34rpx;gap:12rpx}.profile-header .info .stats .stat-divider{color:rgba(75,85,99,.2)}.section{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);margin-bottom:20rpx;padding:24rpx}.section .section-header{margin-bottom:20rpx}.section .section-header .section-title{color:#fff;display:block;font-size:40rpx;font-weight:700;margin-bottom:8rpx}.section .section-header .section-subtitle{color:#9ca3af;display:block;font-size:34rpx}.section .section-title{color:#fff;display:block;font-size:40rpx;font-weight:700;margin-bottom:20rpx}.radar-chart .radar-item{align-items:center;display:flex;gap:16rpx;margin-bottom:16rpx}.radar-chart .radar-item .radar-label{color:#9ca3af;font-size:36rpx;width:140rpx}.radar-chart .radar-item .radar-bar{background:hsla(0,0%,100%,.05);border-radius:9999rpx;flex:1;height:24rpx;overflow:hidden}.radar-chart .radar-item .radar-bar .radar-fill{background:linear-gradient(135deg,#8b5cf6,#6366f1);border-radius:9999rpx;height:100%;transition:width .3s ease}.radar-chart .radar-item .radar-value{color:#06b6d4;font-size:36rpx;font-weight:700;text-align:right;width:60rpx}.tracks{display:flex;gap:16rpx;margin-top:20rpx}.tracks .track-item{border-radius:12rpx;flex:1;padding:20rpx;text-align:center}.tracks .track-item.primary{background:linear-gradient(135deg,rgba(139,92,246,.2),rgba(99,102,241,.2));border:2rpx solid rgba(139,92,246,.3)}.tracks .track-item.secondary{background:linear-gradient(135deg,rgba(59,130,246,.2),rgba(52,211,153,.2));border:2rpx solid rgba(59,130,246,.3)}.tracks .track-item .track-label{color:#9ca3af;display:block;font-size:34rpx;margin-bottom:8rpx}.tracks .track-item .track-value{color:#fff;display:block;font-size:40rpx;font-weight:700}.tags{display:flex;flex-wrap:wrap;gap:12rpx}.tags .tag{border-radius:9999rpx;font-size:34rpx;font-weight:500;padding:12rpx 16rpx}.tags .tag.interest-tag{background:rgba(139,92,246,.15);border:2rpx solid rgba(139,92,246,.3);color:#a78bfa}.tags .tag.skill-tag{background:rgba(0,245,255,.15);border:2rpx solid rgba(0,245,255,.3);color:#06b6d4}.portfolio-item{background:hsla(0,0%,100%,.03);border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;margin-bottom:16rpx;padding:20rpx}.portfolio-item:last-child{margin-bottom:0}.portfolio-item .portfolio-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:8rpx}.portfolio-item .portfolio-header .portfolio-title{color:#fff;font-size:36rpx;font-weight:500}.portfolio-item .portfolio-header .portfolio-rating{color:#fbbf24;font-size:34rpx}.portfolio-item .portfolio-date{color:#9ca3af;display:block;font-size:34rpx;margin-bottom:16rpx}.portfolio-item .portfolio-images{display:flex;gap:12rpx;overflow-x:auto}.portfolio-item .portfolio-images .portfolio-image{border-radius:12rpx;flex-shrink:0;height:200rpx;width:200rpx}