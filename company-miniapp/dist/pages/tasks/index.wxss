-page .task-list .task-card .match-score .match-label{color:#9ca3af;font-size:24rpx}.tasks-page .task-list .task-card .match-score .match-value{color:#667eea;font-size:28rpx;font-weight:600}.tasks-page .task-list .task-card .task-meta{display:flex;justify-content:space-between;margin-bottom:16rpx}.tasks-page .task-list .task-card .task-meta .meta-item{align-items:center;display:flex;gap:8rpx}.tasks-page .task-list .task-card .task-meta .meta-item .meta-label{color:#9ca3af;font-size:26rpx;opacity:.8}.tasks-page .task-list .task-card .task-meta .meta-item .meta-value{color:#fff;font-family:SF Mono,JetBrains Mono,Consolas,monospace;font-size:28rpx;font-weight:500}.tasks-page .task-list .task-card .progress-bar{background:rgba(75,85,99,.2);border-radius:4rpx;height:8rpx;margin:20rpx 0;overflow:hidden}.tasks-page .task-list .task-card .progress-bar .progress-fill{background:linear-gradient(180deg,#8b5cf6,#6366f1);border-radius:4rpx;height:100%;transition:width .3s ease}.tasks-page .task-list .task-card .task-actions{border-top:1rpx solid rgba(75,85,99,.15);display:flex;gap:16rpx;margin-top:20rpx;padding-top:20rpx}.tasks-page .task-list .task-card .task-actions .action-btn{background:transparent;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#9ca3af;flex:1;font-size:28rpx;font-weight:500;padding:16rpx;text-align:center;transition:all .3s ease}.tasks-page .task-list .task-card .task-actions .action-btn.primary{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;box-shadow:0 4rpx 12rpx rgba(102,126,234,.3);color:#fff}.tasks-page .task-list .task-card .task-actions .action-btn:active{transform:scale(.98)}.tasks-page .task-list .empty-state{padding:160rpx 0;text-align:center}.tasks-page .task-list .empty-state .empty-icon{font-size:120rpx;margin-bottom:20rpx;opacity:.3}.tasks-page .task-list .empty-state .empty-text{color:#4b5563;font-size:28rpx;opacity:.6}