@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.company-verify-page{background:#0a0c10;min-height:100vh;padding:20rpx 20rpx 100rpx}.company-verify-page .info-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);background:rgba(59,130,246,.05);border:1px solid rgba(59,130,246,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.company-verify-page .info-card .info-icon{color:#3b82f6;font-size:40rpx;margin-bottom:12rpx}.company-verify-page .info-card .info-title{color:#fff;font-size:38rpx;font-weight:600;margin-bottom:12rpx}.company-verify-page .info-card .info-text{color:#9ca3af;font-size:34rpx;line-height:1.6}.company-verify-page .form-section{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1px solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.company-verify-page .form-section .section-title{border-bottom:1rpx solid rgba(75,85,99,.15);color:#fff;font-size:40rpx;font-weight:600;margin-bottom:20rpx;padding-bottom:16rpx}.company-verify-page .form-section .form-item{margin-bottom:20rpx}.company-verify-page .form-section .form-item:last-child{margin-bottom:0}.company-verify-page .form-section .form-item .label{align-items:center;color:#fff;display:flex;font-size:38rpx;margin-bottom:12rpx}.company-verify-page .form-section .form-item .label .required{color:#ef4444;margin-left:4rpx}.company-verify-page .form-section .form-item .input{background:#1e293b;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;font-size:14rpx;padding:12rpx 16rpx;width:100%}.company-verify-page .form-section .form-item .input:focus{border-color:#6366f1;outline:none}.company-verify-page .form-section .form-item .input::-moz-placeholder{color:#6b7280}.company-verify-page .form-section .form-item .input::placeholder{color:#6b7280}.company-verify-page .form-section .form-item .upload-area{background:rgba(20,28,40,.4);border:2rpx dashed rgba(75,85,99,.2);border-radius:12rpx;cursor:pointer;padding:24rpx;text-align:center}.company-verify-page .form-section .form-item .upload-area:active{background:rgba(75,85,99,.15)}.company-verify-page .form-section .form-item .upload-area .upload-icon{color:#4b5563;font-size:80rpx;margin-bottom:12rpx}.company-verify-page .form-section .form-item .upload-area .upload-text{color:#9ca3af;font-size:34rpx;margin-bottom:6rpx}.company-verify-page .form-section .form-item .upload-area .upload-hint{color:#4b5563;font-size:32rpx}.company-verify-page .form-section .form-item .image-preview{border-radius:12rpx;overflow:hidden;position:relative}.company-verify-page .form-section .form-item .image-preview .preview-image{border-radius:12rpx;width:100%}.company-verify-page .form-section .form-item .image-preview .delete-btn{align-items:center;background:rgba(0,0,0,.6);border-radius:50%;display:flex;height:32rpx;justify-content:center;position:absolute;right:12rpx;top:12rpx;width:32rpx}.company-verify-page .form-section .form-item .image-preview .delete-btn .delete-icon{color:#fff;font-size:40rpx}.company-verify-page .submit-section .submit-btn{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-size:38rpx;font-weight:600;font-weight:500;padding:16rpx;transition:all .3s ease;width:100%}.company-verify-page .submit-section .submit-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.company-verify-page .submit-section .submit-btn:active{transform:translateY(0)}.company-verify-page .submit-section .submit-btn:disabled{cursor:not-allowed;opacity:.5}.company-verify-page .submit-section .submit-btn.disabled{opacity:.5}