@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.pending-ratings-page{background:#0a0c10;min-height:100vh;padding:20rpx 20rpx 100rpx}.pending-ratings-page .rating-list .rating-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1px solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.pending-ratings-page .rating-list .rating-card .task-header{align-items:flex-start;border-bottom:1rpx solid rgba(75,85,99,.15);display:flex;justify-content:space-between;margin-bottom:16rpx;padding-bottom:16rpx}.pending-ratings-page .rating-list .rating-card .task-header .task-info{flex:1}.pending-ratings-page .rating-list .rating-card .task-header .task-info .task-title{color:#fff;font-size:38rpx;font-weight:500;line-height:1.4;margin-bottom:6rpx}.pending-ratings-page .rating-list .rating-card .task-header .task-info .task-time{color:#4b5563;font-size:32rpx}.pending-ratings-page .rating-list .rating-card .task-header .task-status{background:rgba(16,185,129,.1);background:rgba(16,185,129,.08);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:6rpx 16rpx}.pending-ratings-page .rating-list .rating-card .student-info{align-items:center;display:flex;margin-bottom:16rpx}.pending-ratings-page .rating-list .rating-card .student-info .student-avatar{background:#818cf8;border-radius:50%;height:48rpx;margin-right:16rpx;width:48rpx}.pending-ratings-page .rating-list .rating-card .student-info .student-detail{flex:1}.pending-ratings-page .rating-list .rating-card .student-info .student-detail .student-name{color:#fff;font-size:38rpx;font-weight:500;margin-bottom:4rpx}.pending-ratings-page .rating-list .rating-card .student-info .student-detail .student-school{color:#9ca3af;font-size:32rpx}.pending-ratings-page .rating-list .rating-card .rating-action .rate-btn{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-size:34rpx;font-weight:600;padding:12rpx;transition:all .3s ease;width:100%}.pending-ratings-page .rating-list .rating-card .rating-action .rate-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.pending-ratings-page .rating-list .rating-card .rating-action .rate-btn:active{transform:translateY(0)}.pending-ratings-page .rating-list .rating-card .rating-action .rate-btn:disabled{cursor:not-allowed;opacity:.5}.pending-ratings-page .rating-list .empty-state{padding:120rpx 0;text-align:center}.pending-ratings-page .rating-list .empty-state .empty-icon{font-size:120rpx;margin-bottom:20rpx}.pending-ratings-page .rating-list .empty-state .empty-text{color:#4b5563;font-size:38rpx}