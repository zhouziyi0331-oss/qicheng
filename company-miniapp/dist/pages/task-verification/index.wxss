@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.task-verification{background:#0a0c10;min-height:100vh;padding:20rpx 20rpx 180rpx}.task-verification.empty,.task-verification.loading{align-items:center;color:#9ca3af;display:flex;font-size:36rpx;justify-content:center}.task-info{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);margin-bottom:20rpx;padding:24rpx}.task-info .task-title{color:#fff;display:block;font-size:44rpx;font-weight:700;margin-bottom:20rpx}.task-info .student-info{align-items:center;display:flex;gap:16rpx}.task-info .student-info .avatar{border-radius:9999rpx;height:80rpx;width:80rpx}.task-info .student-info .info{flex:1}.task-info .student-info .info .name{color:#fff;display:block;font-size:36rpx;font-weight:500;margin-bottom:8rpx}.task-info .student-info .info .time{color:#9ca3af;display:block;font-size:34rpx}.section{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);margin-bottom:20rpx;padding:24rpx}.section .section-title{color:#fff;display:block;font-size:40rpx;font-weight:700;margin-bottom:20rpx}.section .description{color:#9ca3af;display:block;font-size:36rpx;line-height:1.6}.images{display:grid;gap:16rpx;grid-template-columns:repeat(3,1fr)}.images .image{background:hsla(0,0%,100%,.05);border-radius:12rpx;height:200rpx;width:100%}.link-item{align-items:center;background:hsla(0,0%,100%,.03);border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;display:flex;justify-content:space-between;margin-bottom:12rpx;padding:16rpx}.link-item:last-child{margin-bottom:0}.link-item .link-text{color:#06b6d4;flex:1;font-size:34rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.link-item .link-copy{background:rgba(139,92,246,.2);border-radius:8rpx;color:#9ca3af;font-size:34rpx;padding:8rpx 16rpx}.actions{backdrop-filter:blur(20rpx);background:rgba(10,12,16,.95);border-top:1rpx solid rgba(75,85,99,.2);bottom:0;display:flex;gap:16rpx;left:0;padding:20rpx;position:fixed;right:0}.actions .btn-approve,.actions .btn-reject{border:none;border-radius:16rpx;flex:1;font-size:36rpx;font-weight:700;height:88rpx}.actions .btn-approve::after,.actions .btn-reject::after{border:none}.actions .btn-reject{background:rgba(239,68,68,.15);border:2rpx solid rgba(239,68,68,.3);color:#f87171}.actions .btn-approve{background:linear-gradient(135deg,#8b5cf6,#6366f1);box-shadow:0 0 20rpx rgba(139,92,246,.3);color:#fff}.modal-overlay{align-items:center;backdrop-filter:blur(10rpx);background:rgba(0,0,0,.7);bottom:0;display:flex;justify-content:center;left:0;padding:24rpx;position:fixed;right:0;top:0;z-index:1000}.modal-content{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1rpx solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);max-width:600rpx;padding:24rpx;width:100%}.modal-content .modal-title{color:#fff;display:block;font-size:40rpx;font-weight:700;margin-bottom:20rpx}.modal-content .modal-textarea{background:hsla(0,0%,100%,.05);border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;font-size:36rpx;line-height:1.6;margin-bottom:20rpx;min-height:200rpx;padding:16rpx;width:100%}.modal-content .modal-actions{display:flex;gap:16rpx}.modal-content .modal-actions .modal-btn{border:none;border-radius:16rpx;flex:1;font-size:36rpx;font-weight:700;height:80rpx}.modal-content .modal-actions .modal-btn::after{border:none}.modal-content .modal-actions .modal-btn.cancel{background:hsla(0,0%,100%,.05);border:1rpx solid rgba(75,85,99,.2);color:#9ca3af}.modal-content .modal-actions .modal-btn.confirm{background:linear-gradient(135deg,#8b5cf6,#6366f1);color:#fff}