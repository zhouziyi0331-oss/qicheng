7280}.add-requirement-page .form-section .input-wrapper::placeholder{color:#6b7280}.add-requirement-page .form-section .input-wrapper .input-prefix{color:#fff;font-size:38rpx;margin-right:8rpx}.add-requirement-page .form-section .input-wrapper .input{background:transparent;border:none;color:#fff;flex:1;font-size:38rpx}.add-requirement-page .form-section .hint{color:#9ca3af;font-size:32rpx;margin-top:6rpx}.add-requirement-page .form-section .budget-diff{align-items:center;background:rgba(16,185,129,.08);border-radius:12rpx;display:flex;justify-content:space-between;margin-top:12rpx;padding:16rpx}.add-requirement-page .form-section .budget-diff .diff-label{color:#10b981;font-size:34rpx}.add-requirement-page .form-section .budget-diff .diff-amount{color:#10b981;font-size:40rpx;font-weight:600}.add-requirement-page .tips-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);background:rgba(59,130,246,.05);border:1rpx solid rgba(59,130,246,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.add-requirement-page .tips-card .tips-title{color:#fff;font-size:38rpx;font-weight:600;margin-bottom:12rpx}.add-requirement-page .tips-card .tips-item{color:#9ca3af;font-size:34rpx;line-height:1.6;margin-bottom:6rpx}.add-requirement-page .tips-card .tips-item:last-child{margin-bottom:0}.add-requirement-page .submit-section .submit-btn{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-size:38rpx;font-weight:600;font-weight:500;padding:16rpx;transition:all .3s ease;width:100%}.add-requirement-page .submit-section .submit-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.add-requirement-page .submit-section .submit-btn:active{transform:translateY(0)}.add-requirement-page .submit-section .submit-btn:disabled{cursor:not-allowed;opacity:.5}.add-requirement-page .submit-section .submit-btn.disabled{opacity:.5}