nsition:all .3s ease;width:100%}.login-page .login-card .login-form .login-btn:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.login-page .login-card .login-form .login-btn:active{transform:translateY(0)}.login-page .login-card .login-form .login-btn:disabled{cursor:not-allowed;opacity:.5}.login-page .login-card .divider{align-items:center;display:flex;margin:24rpx 0}.login-page .login-card .divider .divider-line{background:rgba(75,85,99,.15);flex:1;height:1rpx}.login-page .login-card .divider .divider-text{color:#4b5563;font-size:32rpx;padding:0 16rpx}.login-page .login-card .wechat-login .wechat-btn{align-items:center;background:transparent;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;cursor:pointer;display:flex;font-size:14rpx;font-size:38rpx;font-weight:500;gap:12rpx;justify-content:center;padding:16rpx;transition:all .3s ease;width:100%}.login-page .login-card .wechat-login .wechat-btn:hover{background:rgba(30,41,59,.8);border-color:rgba(75,85,99,.4)}.login-page .login-card .wechat-login .wechat-btn:active{transform:scale(.98)}.login-page .login-card .wechat-login .wechat-btn:disabled{cursor:not-allowed;opacity:.5}.login-page .login-card .wechat-login .wechat-btn .wechat-icon{color:#10b981;font-size:40rpx}.login-page .login-card .wechat-login .wechat-btn .btn-text{color:#fff}.login-page .login-card .agreement{color:#4b5563;font-size:32rpx;line-height:1.6;margin-top:20rpx;text-align:center}.login-page .login-card .agreement .link{color:#6366f1}.login-page .footer{margin-top:60rpx;text-align:center}.login-page .footer .footer-text{color:hsla(0,0%,100%,.6);font-size:32rpx;line-height:1.8}