@keyframes glow-pulse{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.05)}}@keyframes slide-up{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}@keyframes fade-in{from{opacity:0}to{opacity:1}}.text-gradient-primary{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;background-clip:text}.text-gradient-blue-green{-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text}.status-success{background:rgba(16,185,129,.1);border-radius:9999rpx;color:#10b981;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-warning{background:rgba(245,158,11,.1);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-error{background:rgba(239,68,68,.1);border-radius:9999rpx;color:#ef4444;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.status-info{background:rgba(59,130,246,.1);border-radius:9999rpx;color:#3b82f6;display:inline-block;font-size:12rpx;font-weight:500;padding:2rpx 10rpx}.amendment-history-page{background:#0a0c10;min-height:100vh;padding:20rpx 20rpx 100rpx}.amendment-history-page .task-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);background:linear-gradient(135deg,#6366f1,#4f46e5);border:none;border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.amendment-history-page .task-card .task-title{color:#fff;font-size:40rpx;font-weight:600;margin-bottom:12rpx}.amendment-history-page .task-card .task-meta{display:flex;gap:16rpx}.amendment-history-page .task-card .task-meta .meta-item{color:hsla(0,0%,100%,.8);font-size:34rpx}.amendment-history-page .amendment-list .amendment-card{backdrop-filter:blur(20rpx);background:rgba(20,28,40,.6);border:1px solid rgba(75,85,99,.2);border-radius:16rpx;box-shadow:0 20rpx 25rpx -5rpx rgba(0,0,0,.5);box-shadow:none;margin-bottom:16rpx}.amendment-history-page .amendment-list .amendment-card .amendment-header{align-items:flex-start;border-bottom:1rpx solid rgba(75,85,99,.15);display:flex;justify-content:space-between;margin-bottom:16rpx;padding-bottom:16rpx}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-info{flex:1}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-info .amendment-type{color:#fff;font-size:38rpx;font-weight:500;margin-bottom:6rpx}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-info .amendment-time{color:#4b5563;font-size:32rpx}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-status{background:rgba(245,158,11,.1);background:rgba(245,158,11,.08);border-radius:9999rpx;color:#f59e0b;display:inline-block;font-size:12rpx;font-weight:500;padding:6rpx 16rpx}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-status.approved{background:rgba(16,185,129,.08);color:#10b981}.amendment-history-page .amendment-list .amendment-card .amendment-header .amendment-status.rejected{background:rgba(239,68,68,.08);color:#ef4444}.amendment-history-page .amendment-list .amendment-card .amendment-detail .detail-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:12rpx}.amendment-history-page .amendment-list .amendment-card .amendment-detail .detail-row:last-child{margin-bottom:0}.amendment-history-page .amendment-list .amendment-card .amendment-detail .detail-row .detail-label{color:#9ca3af;font-size:34rpx}.amendment-history-page .amendment-list .amendment-card .amendment-detail .detail-row .detail-value{color:#fff;font-size:34rpx;font-weight:400}.amendment-history-page .amendment-list .amendment-card .amendment-detail .detail-row .detail-value.highlight{color:#6366f1;font-weight:600}.amendment-history-page .amendment-list .amendment-card .amendment-detail .description{background:rgba(20,28,40,.4);border-radius:12rpx;margin-top:16rpx;padding:16rpx}.amendment-history-page .amendment-list .amendment-card .amendment-detail .description .description-label{color:#9ca3af;font-size:32rpx;margin-bottom:6rpx}.amendment-history-page .amendment-list .amendment-card .amendment-detail .description .description-text{color:#fff;font-size:34rpx;line-height:1.6}.amendment-history-page .amendment-list .amendment-card .amendment-actions{border-top:1rpx solid rgba(75,85,99,.15);display:flex;gap:12rpx;margin-top:16rpx;padding-top:16rpx}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn{border:none;border-radius:12rpx;flex:1;font-size:34rpx;padding:12rpx}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.primary{background:linear-gradient(135deg,#8b5cf6,#6366f1);border:none;border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-weight:600;padding:12rpx 24rpx;transition:all .3s ease}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.primary:hover{box-shadow:0 0 20rpx rgba(139,92,246,.3);transform:translateY(-2rpx)}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.primary:active{transform:translateY(0)}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.primary:disabled{cursor:not-allowed;opacity:.5}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.secondary{background:transparent;border:1rpx solid rgba(75,85,99,.2);border-radius:12rpx;color:#fff;cursor:pointer;font-size:14rpx;font-weight:500;padding:12rpx 24rpx;transition:all .3s ease}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.secondary:hover{background:rgba(30,41,59,.8);border-color:rgba(75,85,99,.4)}.amendment-history-page .amendment-list .amendment-card .amendment-actions .action-btn.secondary:active{transform:scale