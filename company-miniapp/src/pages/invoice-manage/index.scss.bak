.invoice-manage-page {
  min-height: 100vh;
  background: #0f0f1e;
  padding: 20px;

  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    color: #8e8e93;
    font-size: 28px;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;

    .header-info {
      .title {
        display: block;
        font-size: 36px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 8px;
      }

      .subtitle {
        display: block;
        font-size: 24px;
        color: #8e8e93;
      }
    }

    .apply-btn {
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      border-radius: 12px;
      padding: 16px 32px;

      .apply-text {
        font-size: 28px;
        font-weight: 600;
        color: #ffffff;
      }
    }
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 70vh;

    .empty-icon {
      font-size: 120px;
      margin-bottom: 24px;
    }

    .empty-text {
      font-size: 32px;
      color: #ffffff;
      margin-bottom: 12px;
    }

    .empty-hint {
      font-size: 26px;
      color: #8e8e93;
    }
  }

  .invoice-list {
    height: calc(100vh - 160px);
  }

  .invoice-card {
    background: #1a1a2e;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid #2a2a3e;

      .invoice-info {
        flex: 1;

        .invoice-title {
          display: block;
          font-size: 32px;
          font-weight: 600;
          color: #ffffff;
          margin-bottom: 8px;
        }

        .invoice-type {
          display: inline-block;
          background: rgba(59, 130, 246, 0.2);
          color: #3b82f6;
          font-size: 22px;
          padding: 4px 12px;
          border-radius: 6px;
        }
      }

      .status-badge {
        border-radius: 8px;
        padding: 8px 16px;

        &.pending {
          background: rgba(251, 191, 36, 0.2);
          .status-text {
            color: #fbbf24;
          }
        }

        &.processing {
          background: rgba(59, 130, 246, 0.2);
          .status-text {
            color: #3b82f6;
          }
        }

        &.issued {
          background: rgba(52, 211, 153, 0.2);
          .status-text {
            color: #34d399;
          }
        }

        &.rejected {
          background: rgba(239, 68, 68, 0.2);
          .status-text {
            color: #ef4444;
          }
        }

        .status-text {
          font-size: 24px;
          font-weight: 500;
        }
      }
    }

    .card-body {
      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;

        .info-label {
          font-size: 26px;
          color: #8e8e93;
        }

        .info-value {
          font-size: 26px;
          color: #ffffff;
          text-align: right;

          &.amount {
            font-size: 32px;
            font-weight: 600;
            color: #34d399;
          }
        }
      }
    }

    .card-footer {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #2a2a3e;

      .download-btn {
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        border-radius: 12px;
        padding: 20px;
        text-align: center;

        .download-text {
          font-size: 28px;
          font-weight: 600;
          color: #ffffff;
        }
      }
    }
  }
}
