.dispute-page {
  min-height: 100vh;
  background: #0f0f1e;
  padding-bottom: 160px;

  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    color: #8e8e93;
    font-size: 28px;
  }

  .content {
    height: calc(100vh - 160px);
    padding: 20px;
  }

  .task-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;

    .task-title {
      display: block;
      font-size: 32px;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 16px;
      line-height: 1.4;
    }

    .task-meta {
      .meta-item {
        font-size: 26px;
        color: #8e8e93;
      }
    }
  }

  .form-section {
    background: #1a1a2e;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;

    .section-header {
      display: flex;
      align-items: center;
      margin-bottom: 16px;

      .section-title {
        font-size: 28px;
        font-weight: 600;
        color: #ffffff;
      }

      .required {
        color: #ff6b6b;
        margin-left: 8px;
        font-size: 28px;
      }

      .optional {
        color: #8e8e93;
        margin-left: 8px;
        font-size: 24px;
      }
    }

    .type-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;

      .type-item {
        background: #0f0f1e;
        border: 2px solid #2a2a3e;
        border-radius: 12px;
        padding: 24px;
        text-align: center;

        &.active {
          background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);
          border-color: #3b82f6;

          .type-text {
            color: #3b82f6;
            font-weight: 600;
          }
        }

        .type-text {
          font-size: 28px;
          color: #ffffff;
        }
      }
    }

    .textarea {
      width: 100%;
      min-height: 200px;
      background: #0f0f1e;
      border-radius: 12px;
      padding: 20px;
      font-size: 28px;
      color: #ffffff;
      border: 2px solid #2a2a3e;
      box-sizing: border-box;
    }

    .char-count {
      display: block;
      text-align: right;
      font-size: 24px;
      color: #8e8e93;
      margin-top: 8px;
    }

    .evidence-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;

      .evidence-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;

        .evidence-image {
          width: 100%;
          height: 100%;
        }

        .remove-btn {
          position: absolute;
          top: 8px;
          right: 8px;
          width: 48px;
          height: 48px;
          background: rgba(0, 0, 0, 0.6);
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;

          .remove-icon {
            font-size: 36px;
            color: #ffffff;
            line-height: 1;
          }
        }
      }

      .upload-btn {
        aspect-ratio: 1;
        background: #0f0f1e;
        border: 2px dashed #2a2a3e;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        .upload-icon {
          font-size: 48px;
          color: #8e8e93;
          margin-bottom: 8px;
        }

        .upload-text {
          font-size: 22px;
          color: #8e8e93;
        }
      }
    }
  }

  .tips-card {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(251, 191, 36, 0.1) 100%);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;
    border: 2px solid rgba(239, 68, 68, 0.2);

    .tips-title {
      display: block;
      font-size: 28px;
      font-weight: 600;
      color: #ef4444;
      margin-bottom: 16px;
    }

    .tips-item {
      display: block;
      font-size: 26px;
      color: #8e8e93;
      line-height: 1.6;
      margin-bottom: 8px;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .submit-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #1a1a2e;
    padding: 20px;
    border-top: 1px solid #2a2a3e;

    .submit-btn {
      background: linear-gradient(135deg, #ef4444 0%, #f59e0b 100%);
      border-radius: 16px;
      padding: 28px;
      text-align: center;
      box-shadow: 0 8px 24px rgba(239, 68, 68, 0.3);

      &.disabled {
        opacity: 0.5;
        box-shadow: none;
      }

      .submit-text {
        font-size: 32px;
        font-weight: 600;
        color: #ffffff;
      }
    }
  }
}
