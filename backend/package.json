{
  "name": "qicheng-backend",
  "version": "1.0.0",
  "description": "启程 Qicheng Backend API — Node.js + TypeScript",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/src/app.js",
    "start:worker": "node dist/src/worker.js",
    "test": "NODE_ENV=test jest --forceExit",
    "db:migrate": "psql $DATABASE_URL -f ../scripts/db/001_init_schema.sql && psql $DATABASE_URL -f ../scripts/db/002_indexes.sql",
    "db:seed": "psql $DATABASE_URL -f ../scripts/db/003_seed_data.sql",
    "db:vector": "psql $DATABASE_URL -f ../scripts/db/004_vector_setup.sql",
    "migrate": "psql $DATABASE_URL -f migrations/072_semantic_matching_system.sql",
    "init-vectors": "ts-node src/scripts/initVectors.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@types/ali-oss": "^6.23.3",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^3.15.9",
    "@types/pdfkit": "^0.17.5",
    "@types/socket.io": "^3.0.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nanoid": "^5.1.16",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "pgvector": "^0.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
