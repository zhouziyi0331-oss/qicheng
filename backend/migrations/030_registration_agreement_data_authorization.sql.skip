-- 030_registration_agreement_data_authorization.sql
-- 注册协议与数据授权系统

-- 1. 用户协议表
CREATE TABLE IF NOT EXISTS user_agreements (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  agreement_type VARCHAR(50) NOT NULL,       -- service_terms/privacy_policy/data_authorization
  version VARCHAR(20) NOT NULL,              -- 版本号 (e.g., "1.0.0")
  title VARCHAR(200) NOT NULL,               -- 协议标题
  content TEXT NOT NULL,                     -- 协议内容
  effective_date TIMESTAMP NOT NULL,         -- 生效日期
  is_active BOOLEAN DEFAULT TRUE,            -- 是否当前有效版本
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(agreement_type, version)
);

-- 2. 用户协议签署记录表
CREATE TABLE IF NOT EXISTS user_agreement_signatures (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  agreement_id UUID NOT NULL REFERENCES user_agreements(id),
  agreement_type VARCHAR(50) NOT NULL,
  agreement_version VARCHAR(20) NOT NULL,
  ip_address VARCHAR(50),                    -- 签署时的IP地址
  device_info TEXT,                          -- 设备信息
  signed_at TIMESTAMP DEFAULT NOW(),
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(user_id, agreement_id)
);

-- 3. 数据授权设置表
CREATE TABLE IF NOT EXISTS data_authorization_settings (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),

  -- 基础数据授权（必选，注册时默认同意）
  basic_data_authorized BOOLEAN DEFAULT TRUE NOT NULL,  -- 基础信息（姓名、联系方式等）
  task_data_authorized BOOLEAN DEFAULT TRUE NOT NULL,   -- 任务执行数据
  ability_data_authorized BOOLEAN DEFAULT TRUE NOT NULL, -- 能力评估数据

  -- 商业化数据授权（可选，用户可随时修改）
  commercial_use_authorized BOOLEAN DEFAULT FALSE,      -- 数据商业化使用授权
  marketing_authorized BOOLEAN DEFAULT FALSE,           -- 营销推广授权
  third_party_share_authorized BOOLEAN DEFAULT FALSE,   -- 第三方数据共享授权
  ai_training_authorized BOOLEAN DEFAULT FALSE,         -- AI模型训练授权

  -- 授权时间戳
  basic_authorized_at TIMESTAMP DEFAULT NOW(),
  commercial_authorized_at TIMESTAMP,
  marketing_authorized_at TIMESTAMP,
  third_party_authorized_at TIMESTAMP,
  ai_training_authorized_at TIMESTAMP,

  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(user_id)
);

-- 4. 数据授权变更历史表
CREATE TABLE IF NOT EXISTS data_authorization_history (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  authorization_type VARCHAR(50) NOT NULL,   -- commercial_use/marketing/third_party_share/ai_training
  previous_value BOOLEAN NOT NULL,           -- 变更前的值
  new_value BOOLEAN NOT NULL,                -- 变更后的值
  change_reason TEXT,                        -- 变更原因
  ip_address VARCHAR(50),
  changed_at TIMESTAMP DEFAULT NOW(),
  created_at TIMESTAMP DEFAULT NOW()
);

-- 5. 必读条款确认表
CREATE TABLE IF NOT EXISTS mandatory_terms_confirmations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  term_type VARCHAR(50) NOT NULL,            -- age_confirmation/real_name_commitment/data_usage_notice
  confirmed BOOLEAN DEFAULT FALSE,
  confirmed_at TIMESTAMP,
  ip_address VARCHAR(50),
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(user_id, term_type)
);

-- 6. 协议更新通知表
CREATE TABLE IF NOT EXISTS agreement_update_notifications (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id),
  agreement_id UUID NOT NULL REFERENCES user_agreements(id),
  notification_type VARCHAR(20) DEFAULT 'update', -- update/new
  is_read BOOLEAN DEFAULT FALSE,
  read_at TIMESTAMP,
  is_accepted BOOLEAN DEFAULT FALSE,
  accepted_at TIMESTAMP,
  created_at TIMESTAMP DEFAULT NOW()
);

-- 索引
CREATE INDEX IF NOT EXISTS idx_user_agreement_signatures_user ON user_agreement_signatures(user_id);
CREATE INDEX IF NOT EXISTS idx_user_agreement_signatures_agreement ON user_agreement_signatures(agreement_id);
CREATE INDEX IF NOT EXISTS idx_data_authorization_settings_user ON data_authorization_settings(user_id);
CREATE INDEX IF NOT EXISTS idx_data_authorization_history_user ON data_authorization_history(user_id);
CREATE INDEX IF NOT EXISTS idx_mandatory_terms_confirmations_user ON mandatory_terms_confirmations(user_id);
CREATE INDEX IF NOT EXISTS idx_agreement_update_notifications_user ON agreement_update_notifications(user_id);

-- 插入初始协议
INSERT INTO user_agreements (agreement_type, version, title, content, effective_date) VALUES
('service_terms', '1.0.0', '启程OPC孵化平台服务协议',
'【服务协议内容】
1. 服务说明
启程OPC孵化平台（以下简称"本平台"）为学生提供AI任务对接和能力成长服务。

2. 用户权利与义务
2.1 用户有权使用本平台提供的所有功能
2.2 用户需保证提交信息的真实性
2.3 用户需按时完成接受的任务

3. 平台权利与义务
3.1 平台有权对任务质量进行审核
3.2 平台保证用户数据安全
3.3 平台提供7x24小时技术支持

4. 费用与结算
4.1 平台收取15%服务费
4.2 任务报酬在验收通过后7天内结算
4.3 提现最低金额为10元

5. 违约责任
5.1 用户违约需承担相应责任
5.2 平台违约需赔偿用户损失

6. 争议解决
如发生争议，双方应友好协商解决。',
NOW()),

('privacy_policy', '1.0.0', '隐私政策',
'【隐私政策内容】
1. 信息收集
我们收集以下信息：
- 基础信息：姓名、联系方式、学校信息
- 任务数据：任务执行记录、作品提交
- 能力数据：OPC测评结果、能力画像

2. 信息使用
- 提供平台服务
- 任务匹配推荐
- 能力评估分析
- 平台功能优化

3. 信息保护
- 采用加密技术保护数据
- 严格的访问控制
- 定期安全审计

4. 信息共享
- 不会向第三方出售用户信息
- 仅在用户授权下共享必要信息
- 法律要求的情况除外

5. 用户权利
- 查看个人信息
- 修改个人信息
- 删除个人信息
- 撤回授权',
NOW()),

('data_authorization', '1.0.0', '数据授权协议',
'【数据授权协议内容】
1. 基础数据授权（必选）
为了提供服务，您需要授权我们使用：
- 基础信息：用于身份识别和联系
- 任务数据：用于任务管理和结算
- 能力数据：用于能力评估和任务匹配

2. 商业化数据授权（可选）
您可以选择授权我们将您的数据用于：
- 数据商业化：匿名化后用于行业研究
- 营销推广：向您推送相关任务和活动
- 第三方共享：与合作企业共享您的能力画像
- AI训练：用于改进AI推荐算法

3. 授权管理
- 您可以随时修改商业化授权设置
- 撤回授权不影响已完成的数据使用
- 基础数据授权为使用平台的必要条件

4. 数据安全
- 所有数据均加密存储
- 严格的访问权限控制
- 定期安全审计和备份',
NOW());

COMMENT ON TABLE user_agreements IS '用户协议';
COMMENT ON TABLE user_agreement_signatures IS '用户协议签署记录';
COMMENT ON TABLE data_authorization_settings IS '数据授权设置';
COMMENT ON TABLE data_authorization_history IS '数据授权变更历史';
COMMENT ON TABLE mandatory_terms_confirmations IS '必读条款确认';
COMMENT ON TABLE agreement_update_notifications IS '协议更新通知';
