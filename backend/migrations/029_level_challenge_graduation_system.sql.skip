COMMENT ON TABLE level_challenge_tasks IS '跳级挑战任务库';
COMMENT ON TABLE student_challenges IS '学生挑战记录';
COMMENT ON TABLE graduation_applications IS '毕业申请';
COMMENT ON TABLE graduate_benefits IS '毕业生权益';
COMMENT ON TABLE graduate_certifications IS '毕业生认证';
COMMENT ON TABLE investment_connections IS '创投资源对接';
