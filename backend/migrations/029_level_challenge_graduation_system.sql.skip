-- 029_level_challenge_graduation_system.sql
-- 跳级挑战与毕业系统

-- 1. 跳级挑战任务表
CREATE TABLE IF NOT EXISTS level_challenge_tasks (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  level INTEGER NOT NULL,                    -- 目标等级 (1-4)
  track VARCHAR(20) NOT NULL,                -- 赛道 (content/tool)
  title VARCHAR(200) NOT NULL,               -- 挑战任务标题
  description TEXT NOT NULL,                 -- 任务描述
  requirements JSONB NOT NULL,               -- 验收标准
  time_limit INTEGER NOT NULL,               -- 时限（小时）
  pass_score INTEGER NOT NULL DEFAULT 80,    -- 通过分数
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(level, track)
);

-- 2. 学生挑战记录表
CREATE TABLE IF NOT EXISTS student_challenges (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES users(id),
  challenge_task_id UUID NOT NULL REFERENCES level_challenge_tasks(id),
  current_level INTEGER NOT NULL,            -- 挑战前等级
  target_level INTEGER NOT NULL,             -- 目标等级
  status VARCHAR(20) NOT NULL DEFAULT 'in_progress', -- in_progress/submitted/passed/failed
  submission_url TEXT,                       -- 提交作品链接
  submission_content TEXT,                   -- 提交说明
  score INTEGER,                             -- 评分
  feedback TEXT,                             -- 评审反馈
  reviewer_id UUID REFERENCES users(id),  -- 评审人
  started_at TIMESTAMP DEFAULT NOW(),
  submitted_at TIMESTAMP,
  reviewed_at TIMESTAMP,
  cooldown_until TIMESTAMP,                  -- 失败后的冷却期
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- 3. 毕业申请表
CREATE TABLE IF NOT EXISTS graduation_applications (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES users(id),
  track VARCHAR(20) NOT NULL,                -- 毕业赛道
  total_tasks_completed INTEGER NOT NULL,    -- 完成任务总数
  total_earnings DECIMAL(10,2) NOT NULL,     -- 总收入
  portfolio_url TEXT,                        -- 作品集链接
  self_introduction TEXT,                    -- 自我介绍
  career_goals TEXT,                         -- 职业目标
  status VARCHAR(20) NOT NULL DEFAULT 'pending', -- pending/approved/rejected
  reviewer_id UUID REFERENCES users(id),
  review_feedback TEXT,
  applied_at TIMESTAMP DEFAULT NOW(),
  reviewed_at TIMESTAMP,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- 4. 毕业生权益表
CREATE TABLE IF NOT EXISTS graduate_benefits (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES users(id),
  graduation_id UUID NOT NULL REFERENCES graduation_applications(id),
  opc_report_unlocked BOOLEAN DEFAULT FALSE, -- OPC完整报告解锁
  company_contact_unlocked BOOLEAN DEFAULT FALSE, -- 企业联系方式解锁
  certification_issued BOOLEAN DEFAULT FALSE, -- 认证标识发放
  investment_resources_unlocked BOOLEAN DEFAULT FALSE, -- 创投资源解锁
  mentor_network_unlocked BOOLEAN DEFAULT FALSE, -- 导师网络解锁
  priority_tasks_unlocked BOOLEAN DEFAULT FALSE, -- 优先任务推送
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(student_id)
);

-- 5. 毕业生认证表
CREATE TABLE IF NOT EXISTS graduate_certifications (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES users(id),
  certification_number VARCHAR(50) UNIQUE NOT NULL, -- 认证编号
  track VARCHAR(20) NOT NULL,
  level INTEGER NOT NULL DEFAULT 4,
  issued_at TIMESTAMP DEFAULT NOW(),
  expires_at TIMESTAMP,                      -- 认证有效期（可选）
  certificate_url TEXT,                      -- 证书图片URL
  created_at TIMESTAMP DEFAULT NOW()
);

-- 6. 创投资源对接表
CREATE TABLE IF NOT EXISTS investment_connections (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  student_id UUID NOT NULL REFERENCES users(id),
  investor_name VARCHAR(100) NOT NULL,
  investor_type VARCHAR(50),                 -- VC/天使投资人/孵化器
  connection_status VARCHAR(20) DEFAULT 'pending', -- pending/connected/rejected
  introduction TEXT,
  contact_info TEXT,
  connected_at TIMESTAMP,
  created_at TIMESTAMP DEFAULT NOW(),
  updated_at TIMESTAMP DEFAULT NOW()
);

-- 索引
CREATE INDEX IF NOT EXISTS idx_student_challenges_student ON student_challenges(student_id);
CREATE INDEX IF NOT EXISTS idx_student_challenges_status ON student_challenges(status);
CREATE INDEX IF NOT EXISTS idx_graduation_applications_student ON graduation_applications(student_id);
CREATE INDEX IF NOT EXISTS idx_graduation_applications_status ON graduation_applications(status);
CREATE INDEX IF NOT EXISTS idx_graduate_benefits_student ON graduate_benefits(student_id);
CREATE INDEX IF NOT EXISTS idx_graduate_certifications_student ON graduate_certifications(student_id);
CREATE INDEX IF NOT EXISTS idx_investment_connections_student ON investment_connections(student_id);

