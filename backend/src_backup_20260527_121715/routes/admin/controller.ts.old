// M4 客服工具
export async function getTaskMessages(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { taskId } = req.params;
    const messages = await query(
      `SELECT * FROM chat_messages WHERE task_id = $1 ORDER BY created_at ASC`,
      [taskId]
    );
    res.json({ success: true, data: messages });
  } catch (err) { next(err); }
}

export async function interveneTask(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { taskId } = req.params;
    const { action, reason } = req.body; // force_approve / force_refund
    if (!['force_approve', 'force_refund'].includes(action)) {
      throw new AppError(400, '无效的介入操作', 'INVALID_ACTION');
    }
    const newStatus = action === 'force_approve' ? 'completed' : 'cancelled';
    await query(`UPDATE tasks SET status = $1 WHERE id = $2`, [newStatus, taskId]);
    res.json({ success: true, message: `任务已${action === 'force_approve' ? '强制通过' : '强制退款'}` });
  } catch (err) { next(err); }
}

export async function sendAdminNotification(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { userId } = req.params;
    const { title, content } = req.body;
    await query(
      `INSERT INTO notifications (user_id, type, title, content) VALUES ($1, 'admin_message', $2, $3)`,
      [userId, title, content]
    );
    res.json({ success: true, message: '通知已发送' });
  } catch (err) { next(err); }
}

// M5 标签管理
export async function getTags(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const distribution = await query(`
      SELECT tag_category, tag_value, COUNT(*) as user_count
      FROM user_tags
      GROUP BY tag_category, tag_value
      ORDER BY tag_category, user_count DESC`);
    res.json({ success: true, data: distribution });
  } catch (err) { next(err); }
}

export async function updateUserTag(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { userId } = req.params;
    const { category, value, reason } = req.body;
    await query(
      `INSERT INTO user_tags (user_id, tag_category, tag_value, source)
       VALUES ($1, $2, $3, 'manual')
       ON CONFLICT (user_id, tag_category, tag_value) DO UPDATE SET updated_at = NOW()`,
      [userId, category, value]
    );
    res.json({ success: true });
  } catch (err) { next(err); }
}

// M6 财务管理
export async function getPayments(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const payments = await query(`
      SELECT p.*, u.phone, t.title as task_title
      FROM income_records p
      LEFT JOIN users u ON u.id = p.student_id
      LEFT JOIN tasks t ON t.id = p.task_id
      WHERE p.deleted_at IS NULL ORDER BY p.created_at DESC LIMIT 100`);
    res.json({ success: true, data: payments });
  } catch (err) { next(err); }
}

export async function getWithdrawals(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const withdrawals = await query(`
      SELECT w.*, u.phone FROM withdrawal_requests w
      JOIN users u ON u.id = w.user_id
      WHERE w.deleted_at IS NULL ORDER BY w.requested_at DESC LIMIT 100`);
    res.json({ success: true, data: withdrawals });
  } catch (err) { next(err); }
}

export async function approveWithdrawal(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { id } = req.params;
    await query(
      `UPDATE withdrawal_requests SET status = 'processing', admin_id = $1, processed_at = NOW()
       WHERE id = $2 AND status = 'pending'`,
      [req.user!.userId, id]
    );
    res.json({ success: true, message: '提现已审核通过，处理中' });
  } catch (err) { next(err); }
}

export async function getFirstTaskAdvances(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const advances = await query(`
      SELECT p.id, p.net_amount, p.settled_at, p.created_at, u.phone, u.university
      FROM income_records p JOIN users u ON u.id = p.user_id
      WHERE p.is_first_task = TRUE AND p.payer = 'platform'
      ORDER BY p.created_at DESC LIMIT 100`);
    res.json({ success: true, data: advances });
  } catch (err) { next(err); }
}

// M7 通知推送
export async function broadcastNotification(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { targetTag, title, content, roles } = req.body;

    let userIds: string[] = [];

    if (roles && roles.length > 0) {
      // 按角色筛选
      const users = await query<{ id: string }>(
        `SELECT id FROM users WHERE role = ANY($1) AND deleted_at IS NULL`,
        [roles]
      );
      userIds = users.map(u => u.id);
    } else if (targetTag) {
      // 按标签筛选
      const { category, value } = targetTag;
      const users = await query<{ user_id: string }>(
        `SELECT DISTINCT user_id FROM user_tags
         WHERE tag_category = $1 AND tag_value = $2`,
        [category, value]
      );
      userIds = users.map(u => u.user_id);
    } else {
      // 全员推送
      const users = await query<{ id: string }>(
        `SELECT id FROM users WHERE deleted_at IS NULL`
      );
      userIds = users.map(u => u.id);
    }

    // 批量插入通知
    if (userIds.length > 0) {
      const values = userIds.map((userId, i) =>
        `($${i * 3 + 1}, 'admin_broadcast', $${i * 3 + 2}, $${i * 3 + 3})`
      ).join(',');

      const params = userIds.flatMap(userId => [userId, title, content]);

      await query(
        `INSERT INTO notifications (user_id, type, title, content) VALUES ${values}`,
        params
      );
    }

    res.json({
      success: true,
      message: `广播通知已发送给 ${userIds.length} 位用户`,
      count: userIds.length
    });
  } catch (err) { next(err); }
}

// M8 操作日志
export async function getAdminLogs(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const isSuper = req.user?.adminRole === 'super';
    const logs = await query(`
      SELECT aol.*, u.phone
      FROM admin_operation_logs aol
      JOIN users u ON u.id = aol.admin_id
      WHERE ${isSuper ? 'TRUE' : 'aol.admin_id = $1'}
      ORDER BY aol.created_at DESC LIMIT 100`,
      isSuper ? [] : [req.user!.userId]
    );
    res.json({ success: true, data: logs });
  } catch (err) { next(err); }
}

// M9 系统配置
export async function getSystemConfig(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const configs = await query('SELECT key, value, description FROM system_config ORDER BY key');
    res.json({ success: true, data: configs });
  } catch (err) { next(err); }
}

export async function updateSystemConfig(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { key } = req.params;
    const { value } = req.body;
    await query(
      `UPDATE system_config SET value = $1, updated_at = NOW(), updated_by = $2 WHERE key = $3`,
      [value, req.user!.userId, key]
    );
    res.json({ success: true, message: '配置已更新' });
  } catch (err) { next(err); }
}
