import { Request, Response, NextFunction } from 'express';
import { query, queryOne } from '../../utils/db';
import { AppError } from '../../middleware/errorHandler';

// ============================================================
// M1 数据看板
// ============================================================
export async function getDashboard(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const [
      userStats, taskStats, financialStats,
      onboardingConversion, emotionDistribution
    ] = await Promise.all([
      // 用户统计
      queryOne(`
        SELECT
          COUNT(*) FILTER (WHERE role = 'student') as total_students,
          COUNT(*) FILTER (WHERE role = 'company') as total_companies,
          COUNT(*) FILTER (WHERE role = 'student' AND last_login_at > NOW() - interval '1 day') as dau_students,
          COUNT(*) FILTER (WHERE role = 'student' AND last_login_at > NOW() - interval '7 days') as wau_students,
          COUNT(*) FILTER (WHERE role = 'student' AND created_at > NOW() - interval '24 hours') as new_today
        FROM users WHERE deleted_at IS NULL`),

      // 任务统计
      queryOne(`
        SELECT
          COUNT(*) as total_tasks,
          COUNT(*) FILTER (WHERE status = 'completed') as completed_tasks,
          ROUND(COUNT(*) FILTER (WHERE status = 'completed') * 100.0 / NULLIF(COUNT(*), 0), 1) as completion_rate,
          AVG(EXTRACT(EPOCH FROM (completed_at - assigned_at))/3600) FILTER (WHERE status = 'completed') as avg_hours
        FROM task_assignments`),

      // 财务统计
      queryOne(`
        SELECT
          SUM(amount) as total_gross,
          SUM(platform_fee) as total_platform_fee,
          SUM(amount - platform_fee) as total_settled
        FROM income_records WHERE deleted_at IS NULL`),

      // Onboarding 各节点转化率 (核心指标)
      queryOne(`
        SELECT
          COUNT(*) as total,
          COUNT(j1_completed_at) as j1_done,
          COUNT(j2_completed_at) as j2_done,
          COUNT(j3_completed_at) as j3_done,
          COUNT(j4_completed_at) as j4_done,
          COUNT(j5_completed_at) as j5_done,
          COUNT(j6_completed_at) as j6_done,
          COUNT(j7_completed_at) as j7_done,
          COUNT(j8_completed_at) as j8_done,
          -- 首单完成率 (核心指标)
          ROUND(COUNT(j8_completed_at) * 100.0 / NULLIF(COUNT(*), 0), 1) as first_task_completion_rate
        FROM onboarding_status`),

      // 情绪状态分布 (v7新增)
      query(`
        SELECT signal_type, COUNT(*) as count
        FROM emotion_signals
        WHERE resolved_at IS NULL AND deleted_at IS NULL
        GROUP BY signal_type`),
    ]);

    res.json({
      success: true,
      data: {
        users: userStats,
        tasks: taskStats,
        finance: financialStats,
        onboarding: onboardingConversion,
        emotion: emotionDistribution,
      },
    });
  } catch (err) { next(err); }
}

// M2 企业需求管理
export async function getCompanyTasks(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const tasks = await query(`
      SELECT t.id, t.title, t.status, t.budget_gross, t.level_required,
             t.created_at, cp.company_name, cp.contact_name, cp.contact_phone
      FROM tasks t
      JOIN company_profiles cp ON cp.user_id = t.company_id
      WHERE t.deleted_at IS NULL
      ORDER BY t.created_at DESC LIMIT 100`);
    res.json({ success: true, data: tasks });
  } catch (err) { next(err); }
}

export async function takedownTask(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { id } = req.params;
    const { reason } = req.body;
    await query(
      `UPDATE tasks SET status = 'cancelled', deleted_at = NOW() WHERE id = $1`,
      [id]
    );
    res.json({ success: true, message: '任务已下架' });
  } catch (err) { next(err); }
}

export async function blacklistCompany(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { id } = req.params;
    const { reason } = req.body;
    await query(
      `UPDATE company_profiles SET is_blacklisted = TRUE, blacklist_reason = $1 WHERE user_id = $2`,
      [reason, id]
    );
    res.json({ success: true, message: '企业已加入黑名单' });
  } catch (err) { next(err); }
}

// M3 学生身份数据
export async function listStudents(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const isSuper = req.user?.adminRole === 'super';
    const students = await query(`
      SELECT u.id,
        ${isSuper ? 'u.phone' : "regexp_replace(u.phone, '(\\d{3})\\d{4}(\\d{4})', '\\1****\\2') as phone"},
        u.nickname, u.university, u.city, u.created_at, u.last_login_at,
        sp.level_a, sp.level_b, sp.opc_label, sp.task_count, sp.total_earnings,
        sp.graduated_at
      FROM users u
      JOIN student_profiles sp ON sp.user_id = u.id
      WHERE u.role = 'student' AND u.deleted_at IS NULL
      ORDER BY u.created_at DESC LIMIT 100`);
    res.json({ success: true, data: students });
  } catch (err) { next(err); }
}

export async function getStudentDetail(req: Request, res: Response, next: NextFunction): Promise<void> {
  try {
    const { userId } = req.params;
    const isSuper = req.user?.adminRole === 'super';

    const [profile, testHistory, taskHistory, financeHistory] = await Promise.all([
      queryOne(`
        SELECT u.id, ${isSuper ? 'u.phone' : "regexp_replace(u.phone,'(\\d{3})\\d{4}(\\d{4})','\\1****\\2') as phone"},
               u.nickname, u.university, u.city, u.source_channel, u.created_at,
               sp.*, sb.balance, sb.total_earned
        FROM users u
        JOIN student_profiles sp ON sp.user_id = u.id
        JOIN student_balances sb ON sb.user_id = u.id
        WHERE u.id = $1`, [userId]),

      query(`SELECT * FROM test_results WHERE user_id = $1 ORDER BY created_at DESC`, [userId]),
      query(`
        SELECT ta.*, t.title, t.budget_net, ts.ai_score, ts.company_score
        FROM task_assignments ta
        JOIN tasks t ON t.id = ta.task_id
        LEFT JOIN task_submissions ts ON ts.task_id = ta.task_id AND ts.student_id = ta.student_id
        WHERE ta.student_id = $1 ORDER BY ta.assigned_at DESC LIMIT 50`, [userId]),
      query(`SELECT * FROM income_records WHERE user_id = $1 ORDER BY created_at DESC LIMIT 50`, [userId]),
    ]);

    res.json({ success: true, data: { profile, testHistory, taskHistory, financeHistory } });
  } catch (err) { next(err); }
}

