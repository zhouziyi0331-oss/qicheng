# 启程平台 - 环境变量配置

## 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qicheng
DB_USER=postgres
DB_PASSWORD=your_password

## Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

## JWT密钥
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars

## 服务端口
PORT=3000
NODE_ENV=development

## 阿里云短信服务 (可选)
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=启程
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

## 阿里云OSS存储 (可选)
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=qicheng-prod
OSS_CDN_DOMAIN=cdn.qicheng.com

## 微信支付 (可选)
WECHAT_APP_ID=wx_your_app_id
WECHAT_MCH_ID=your_merchant_id
WECHAT_API_KEY=your_api_key_32_characters_long

## 支付宝支付 (可选)
ALIPAY_APP_ID=2021000000000000
ALIPAY_PRIVATE_KEY=your_rsa_private_key
ALIPAY_PUBLIC_KEY=alipay_rsa_public_key

## Anthropic AI (可选)
ANTHROPIC_API_KEY=sk-ant-your-api-key

## 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

## CORS配置
CORS_ORIGIN=http://localhost:3001

## 管理员配置
SUPER_ADMIN_PHONE=13800138000
SUPER_ADMIN_PASSWORD=admin123456
