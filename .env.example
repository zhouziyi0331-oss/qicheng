# ============================================================
# 启程 (Qicheng) 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# 服务器
NODE_ENV=development
PORT=3000

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qicheng

# Redis
REDIS_URL=redis://localhost:6379

# JWT (生产环境必须更换为随机强密钥)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# AI 服务
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# 阿里云 OSS (交付物存储)
OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
OSS_BUCKET=qicheng-files
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
PAYMENT_NOTIFY_BASE_URL=https://api.qicheng.app

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# 推送服务
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
WECHAT_SERVICE_NOTIFY_URL=

# 首单结算配置 (24小时)
FIRST_TASK_SETTLEMENT_HOURS=24
NORMAL_TASK_SETTLEMENT_DAYS=7
MIN_WITHDRAWAL_AMOUNT=10
AUTO_WITHDRAWAL_LIMIT=1000
MAX_ASSIGNEES=3
